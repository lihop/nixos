 KODI_BIN=$(ps aux | grep -E 'kodi.bin|kodi-x11|kodi-wayland|kodi-gbm' | grep -v 'grep.*kodi' | head -n1 | awk '{print $11}' | sed 's:.*/::')
+
+# Hyprland helper functions (compatible drop-in replacements for wmctrl/xdotool)
+get_steam_bpm_addr() {
+    hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.title | test("Steam Big Picture Mode"; "i")) | .address' 2>/dev/null | head -n1
+}
+
+get_steam_desktop_addr() {
+    hyprctl clients -j 2>/dev/null | jq -r '.[] | select((.class | test("steam"; "i")) and (.title | test("^Steam$|^$"; "i"))) | .address' 2>/dev/null | head -n1
+}
+
+get_kodi_addr() {
+    hyprctl clients -j 2>/dev/null | jq -r '.[] | select(.class | test("^kodi$"; "i")) | .address' 2>/dev/null | head -n1
+}
+
+focus_window() {
+    [[ -n "$1" ]] && hyprctl dispatch focuswindow "address:$1" >/dev/null 2>&1
+}
+
+fullscreen_window() {
+    [[ -n "$1" ]] && focus_window "$1" && hyprctl dispatch fullscreen 1 >/dev/null 2>&1
+}
+
+minimize_window() {
+    [[ -n "$1" ]] && hyprctl dispatch movetoworkspacesilent "special:kodi,address:$1" >/dev/null 2>&1
+}
